<?xml version="1.0" encoding="UTF-8" ?>
<OpenSimDocument Version="40000">
	<InverseKinematicsTool name="default_IK">
		<!--Directory used for writing results.-->
		<results_directory>./opensim/Results</results_directory>
		<!--Directory for input files-->
		<input_directory />
		<!--Name of the model file (.osim) to use for inverse kinematics.-->
		<model_file>models/Rajagopal_Pose2Sim_scaled.osim</model_file>
		<!--A positive scalar that is used to weight the importance of satisfying constraints. A weighting of 'Infinity' or if it is negative results in the constraints being strictly enforced.-->
		<constraint_weight>20</constraint_weight>
		<!--The accuracy of the solution in absolute terms. I.e. the number of significantdigits to which the solution can be trusted.-->
		<accuracy>0.0001</accuracy>
		<!--Markers and tasks to be used for inverse kinematics.-->
		<IKTaskSet>
			<objects>
				<IKMarkerTask name="Neck">
					<apply>true</apply>
					<weight>10</weight>
				</IKMarkerTask>
				<IKMarkerTask name="RShoulder">
					<apply>true</apply>
					<weight>5</weight>
				</IKMarkerTask>
				<IKMarkerTask name="LShoulder">
					<apply>true</apply>
					<weight>5</weight>
				</IKMarkerTask>
				<IKMarkerTask name="RHip">
					<apply>true</apply>
					<weight>10</weight>
				</IKMarkerTask>
				<IKMarkerTask name="LHip">
					<apply>true</apply>
					<weight>10</weight>
				</IKMarkerTask>
				<IKMarkerTask name="RKnee">
					<apply>true</apply>
					<weight>15</weight>
				</IKMarkerTask>
				<IKMarkerTask name="LKnee">
					<apply>true</apply>
					<weight>15</weight>
				</IKMarkerTask>
				<IKMarkerTask name="RAnkle">
					<apply>true</apply>
					<weight>20</weight>
				</IKMarkerTask>
				<IKMarkerTask name="LAnkle">
					<apply>true</apply>
					<weight>20</weight>
				</IKMarkerTask>
				<IKMarkerTask name="RBigToe">
					<apply>true</apply>
					<weight>10</weight>
				</IKMarkerTask>
				<IKMarkerTask name="LBigToe">
					<apply>true</apply>
					<weight>10</weight>
				</IKMarkerTask>
				<IKMarkerTask name="RHeel">
					<apply>true</apply>
					<weight>15</weight>
				</IKMarkerTask>
				<IKMarkerTask name="LHeel">
					<apply>true</apply>
					<weight>15</weight>
				</IKMarkerTask>
			</objects>
			<groups />
		</IKTaskSet>
		<!--TRC file (.trc) containing the time history of experimental marker positions (usually interpolated, filtered markers).-->
		<marker_file>pose-3d/trial_filt_augmented.trc</marker_file>
		<!--Name of the motion file (.mot) to which the results of inverse kinematics should be written.-->
		<output_motion_file>opensim/Results/trial_kinematics.mot</output_motion_file>
		<!--Flag indicating whether or not to report marker errors for this run.-->
		<report_marker_locations>false</report_marker_locations>
	</InverseKinematicsTool>
</OpenSimDocument>
