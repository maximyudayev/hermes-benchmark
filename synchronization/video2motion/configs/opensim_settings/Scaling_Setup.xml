<?xml version="1.0" encoding="UTF-8" ?>
<OpenSimDocument Version="40000">
	<ScaleTool name="subject_scaling">
		<!--Mass of the subject in kg.-->
		<mass>75.0</mass>
		<!--Height of the subject in mm.-->
		<height>1750.0</height>
		<!--Age of the subject in years.-->
		<age>25.0</age>
		<!--Notes for the subject.-->
		<notes>HERMES benchmark participant</notes>
		<GenericModelMaker>
			<!--Model file (.osim) to be scaled.-->
			<model_file>models/Rajagopal_Pose2Sim.osim</model_file>
			<!--Set of marker pairs used to scale the model.-->
			<marker_set_file />
		</GenericModelMaker>
		<ModelScaler>
			<!--Whether or not to use the model scaler during scale.-->
			<apply>true</apply>
			<!--TRC file (.trc) containing static trial marker positions.-->
			<marker_file>pose-3d/static_trial.trc</marker_file>
			<!--Time range over which the marker positions are averaged.-->
			<time_range>0.5 1.5</time_range>
			<!--Flag indicating whether or not to preserve relative mass distributions.-->
			<preserve_mass_distribution>true</preserve_mass_distribution>
			<!--Name of OpenSim model file (.osim) to write when done scaling.-->
			<output_model_file>models/Rajagopal_Pose2Sim_scaled.osim</output_model_file>
		</ModelScaler>
	</ScaleTool>
</OpenSimDocument>
